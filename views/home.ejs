<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
  <%- include("./partials/head") %>
  <title>Blogifyer | Discover Inspiring Stories</title>
  <style>
    :root {
      --primary: #2c3e50;
      --secondary: #3498db;
      --accent: #e74c3c;
      --light: #ecf0f1;
      --dark: #2c3e50;
      --text: #333;
      --text-light: #777;
      --shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
      --transition: all 0.3s ease;
    }
    
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      font-family: 'Montserrat', sans-serif;
      background-color: #f8f9fa;
      color: var(--text);
      line-height: 1.6;
    }
    
    .container {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 20px;
    }
    
    /* Header */
    .hero {
      position: relative;
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      color: white;
      padding: 6rem 0 12rem;
      text-align: center;
      clip-path: polygon(0 0, 100% 0, 100% 85%, 0 100%);
      margin-bottom: 2rem;
    }
    
    .hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image: url('https://images.unsplash.com/photo-1542435503-956c469947f6?ixlib=rb-1.2.1&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&w=1074&q=80');
      background-size: cover;
      background-position: center;
      opacity: 0.15;
      z-index: 0;
    }
    
    .hero-content {
      position: relative;
      z-index: 1;
      max-width: 800px;
      margin: 0 auto;
    }
    
    .hero h1 {
      font-family: 'Playfair Display', serif;
      font-size: 3.5rem;
      margin-bottom: 1rem;
      letter-spacing: -0.5px;
    }
    
    .hero p {
      font-size: 1.2rem;
      margin-bottom: 1.5rem;
      opacity: 0.9;
    }
    
    .search-container {
      max-width: 600px;
      margin: 2rem auto 0;
      position: relative;
    }
    
    .search-box {
      width: 100%;
      padding: 1rem 1.5rem;
      border-radius: 50px;
      border: none;
      font-size: 1rem;
      box-shadow: var(--shadow);
      transition: var(--transition);
    }
    
    .search-box:focus {
      outline: none;
      box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.3);
    }
    
    .search-btn {
      position: absolute;
      right: 5px;
      top: 5px;
      background: var(--secondary);
      color: white;
      border: none;
      border-radius: 50px;
      width: 42px;
      height: 42px;
      cursor: pointer;
      transition: var(--transition);
    }
    
    .search-btn:hover {
      background: var(--primary);
    }
    
    /* Category Pills */
    .categories {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 10px;
      margin: 3rem auto;
      max-width: 900px;
    }
    
    .category-pill {
      background-color: white;
      color: var(--primary);
      padding: 0.5rem 1.5rem;
      border-radius: 50px;
      font-size: 0.9rem;
      font-weight: 500;
      box-shadow: 0 3px 10px rgba(0,0,0,0.05);
      cursor: pointer;
      transition: var(--transition);
    }
    
    .category-pill:hover, .category-pill.active {
      background-color: var(--secondary);
      color: white;
      transform: translateY(-3px);
    }
    
    /* Blog Grid */
    .blog-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 2.5rem;
      margin: 2rem 0 5rem;
    }
    
    .blog-card {
      background-color: white;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: var(--shadow);
      transition: var(--transition);
      position: relative;
      height: 400px;
    }
    
    .blog-card:hover {
      transform: translateY(-10px);
      box-shadow: 0 15px 35px rgba(0,0,0,0.1);
    }
    
    .card-img-container {
      height: 200px;
      overflow: hidden;
      position: relative;
    }
    
    .card-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }
    
    .blog-card:hover .card-img {
      transform: scale(1.1);
    }
    
    .card-category {
      position: absolute;
      top: 15px;
      left: 15px;
      background-color: var(--accent);
      color: white;
      padding: 0.2rem 0.8rem;
      border-radius: 50px;
      font-size: 0.8rem;
      font-weight: 500;
    }
    
    .card-content {
      padding: 1.5rem;
      position: relative;
    }
    
    .card-date {
      color: var(--text-light);
      font-size: 0.85rem;
      margin-bottom: 0.5rem;
      display: block;
    }
    
    .card-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.3rem;
      margin-bottom: 0.75rem;
      color: var(--dark);
      line-height: 1.3;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    
    .card-excerpt {
      color: var(--text-light);
      font-size: 0.95rem;
      margin-bottom: 1.5rem;
      line-height: 1.6;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    
    .card-link {
      display: inline-flex;
      align-items: center;
      color: var(--secondary);
      text-decoration: none;
      font-weight: 600;
      font-size: 0.9rem;
      transition: var(--transition);
    }
    
    .card-link i {
      margin-left: 5px;
      transition: var(--transition);
    }
    
    .card-link:hover {
      color: var(--primary);
    }
    
    .card-link:hover i {
      transform: translateX(4px);
    }
    
    /* Author */
    .card-author {
      display: flex;
      align-items: center;
      position: absolute;
      bottom: 1.5rem;
      left: 1.5rem;
    }
    
    .author-img {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      object-fit: cover;
      margin-right: 10px;
    }
    
    .author-name {
      font-size: 0.85rem;
      font-weight: 500;
    }
    
    /* Newsletter */
    .newsletter {
      background-color: var(--primary);
      color: white;
      padding: 5rem 0;
      margin: 3rem 0;
      text-align: center;
      clip-path: polygon(0 15%, 100% 0, 100% 85%, 0 100%);
    }
    
    .newsletter-content {
      max-width: 600px;
      margin: 0 auto;
    }
    
    .newsletter h2 {
      font-family: 'Playfair Display', serif;
      font-size: 2.5rem;
      margin-bottom: 1rem;
    }
    
    .newsletter p {
      margin-bottom: 2rem;
      opacity: 0.9;
    }
    
    .newsletter-form {
      display: flex;
      max-width: 500px;
      margin: 0 auto;
    }
    
    .newsletter-input {
      flex: 1;
      padding: 1rem 1.5rem;
      border-radius: 50px 0 0 50px;
      border: none;
      font-size: 1rem;
    }
    
    .newsletter-input:focus {
      outline: none;
    }
    
    .newsletter-btn {
      background-color: var(--accent);
      color: white;
      border: none;
      padding: 0 1.5rem;
      border-radius: 0 50px 50px 0;
      font-weight: 600;
      cursor: pointer;
      transition: var(--transition);
    }
    
    .newsletter-btn:hover {
      background-color: #c0392b;
    }
    
    /* Pagination */
    .pagination {
      display: flex;
      justify-content: center;
      margin: 3rem 0;
    }
    
    .page-link {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      margin: 0 5px;
      background-color: white;
      color: var(--text);
      border-radius: 50%;
      text-decoration: none;
      font-weight: 500;
      box-shadow: 0 3px 10px rgba(0,0,0,0.05);
      transition: var(--transition);
    }
    
    .page-link:hover, .page-link.active {
      background-color: var(--secondary);
      color: white;
    }
    
    /* Fade In Animation */
    .fade-in {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.5s ease, transform 0.5s ease;
    }
    
    .fade-in.appear {
      opacity: 1;
      transform: translateY(0);
    }
    
    /* Responsive */
    @media (max-width: 992px) {
      .hero {
        padding: 5rem 0 10rem;
      }
      
      .hero h1 {
        font-size: 3rem;
      }
    }
    
    @media (max-width: 768px) {
      .hero {
        padding: 4rem 0 8rem;
      }
      
      .hero h1 {
        font-size: 2.5rem;
      }
      
      .hero p {
        font-size: 1rem;
      }
      
      .blog-grid {
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 2rem;
      }
      
      .newsletter h2 {
        font-size: 2rem;
      }
      
      .newsletter-form {
        flex-direction: column;
      }
      
      .newsletter-input {
        border-radius: 50px;
        margin-bottom: 1rem;
      }
      
      .newsletter-btn {
        border-radius: 50px;
        padding: 1rem;
      }
    }
    
    @media (max-width: 576px) {
      .hero h1 {
        font-size: 2rem;
      }
      
      .blog-grid {
        grid-template-columns: 1fr;
      }
      
      .categories {
        justify-content: flex-start;
        overflow-x: auto;
        padding-bottom: 1rem;
        margin: 2rem 0;
      }
      
      .category-pill {
        flex-shrink: 0;
      }
    }
  </style>
</head>
<body>
  <%- include("./partials/nav") %>
  
  <!-- Hero Section -->
  <header class="hero animate__animated animate__fadeIn">
    <div class="hero-content">
      <h1>Discover Inspiring Stories</h1>
      <p>Explore thought-provoking articles from writers around the world</p>
      
      <div class="search-container">
        <form action="/search" method="GET">
          <input type="text" class="search-box" placeholder="Search for articles, topics, or authors..." name="query">
          <button type="submit" class="search-btn"><i class="fas fa-search"></i></button>
        </form>
      </div>
    </div>
  </header>
  
  <div class="container">
    <!-- Categories -->
    <div class="categories animate__animated animate__fadeInUp">
      <a href="/" class="category-pill active">All</a>
      <a href="/category/technology" class="category-pill">Technology</a>
      <a href="/category/lifestyle" class="category-pill">Lifestyle</a>
      <a href="/category/travel" class="category-pill">Travel</a>
      <a href="/category/health" class="category-pill">Health</a>
      <a href="/category/business" class="category-pill">Business</a>
      <a href="/category/science" class="category-pill">Science</a>
    </div>
    
    <!-- Featured Article (First blog post highlighted) -->
    <% if (blogs.length > 0) { %>
      <div class="featured-article fade-in">
        <div class="blog-card" style="display: grid; grid-template-columns: 1fr 1fr; height: auto; max-height: none; width: 100%;">
          <div class="card-img-container" style="height: 100%;">
            <img src="<%= blogs[0].coverImageUrl %>" alt="<%= blogs[0].title %>" class="card-img">
            <span class="card-category">Featured</span>
          </div>
          <div class="card-content" style="padding: 2rem;">
            <span class="card-date"><i class="far fa-calendar-alt"></i> <%= new Date(blogs[0].createdAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %></span>
            <h2 class="card-title" style="font-size: 1.8rem; -webkit-line-clamp: 3;"><%= blogs[0].title %></h2>
            <p class="card-excerpt" style="-webkit-line-clamp: 5;"><%= blogs[0].body.substring(0, 200) %>...</p>
            <a href="/blog/<%= blogs[0]._id %>" class="card-link">
              Continue Reading <i class="fas fa-arrow-right"></i>
            </a>
            <div class="card-author">
              <img src="/img/default-avatar.jpg" alt="Author" class="author-img">
              <span class="author-name"><%= blogs[0].author || 'Anonymous' %></span>
            </div>
          </div>
        </div>
      </div>
    <% } %>
    
    <!-- Blog Grid -->
    <div class="blog-grid">
      <% blogs.slice(1).forEach(blog => { %>
        <div class="blog-card fade-in">
          <div class="card-img-container">
            <img src="<%= blog.coverImageUrl %>" alt="<%= blog.title %>" class="card-img">
            <span class="card-category"><%= blog.category || 'General' %></span>
          </div>
          <div class="card-content">
            <span class="card-date"><i class="far fa-calendar-alt"></i> <%= new Date(blog.createdAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %></span>
            <h2 class="card-title"><%= blog.title %></h2>
            <p class="card-excerpt"><%= blog.body.substring(0, 100) %>...</p>
            <a href="/blog/<%= blog._id %>" class="card-link">
              Read More <i class="fas fa-arrow-right"></i>
            </a>
            <div class="card-author">
              <img src="/img/default-avatar.jpg" alt="Author" class="author-img">
              <span class="author-name"><%= blog.author || 'Anonymous' %></span>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
    
    <!-- Pagination -->
    <div class="pagination fade-in">
      <a href="#" class="page-link active">1</a>
      <a href="#" class="page-link">2</a>
      <a href="#" class="page-link">3</a>
      <a href="#" class="page-link"><i class="fas fa-ellipsis-h"></i></a>
      <a href="#" class="page-link"><i class="fas fa-angle-right"></i></a>
    </div>
  </div>
  
  <!-- Newsletter Section -->
  <section class="newsletter animate__animated animate__fadeIn">
    <div class="container">
      <div class="newsletter-content">
        <h2>Stay Inspired</h2>
        <p>Subscribe to our newsletter and never miss our newest stories, articles, and tutorials.</p>
        <form class="newsletter-form">
          <input type="email" class="newsletter-input" placeholder="Your email address" required>
          <button type="submit" class="newsletter-btn">Subscribe</button>
        </form>
      </div>
    </div>
  </section>
  
  <%- include("./partials/footer") %>
  <%- include("./partials/scripts") %>
  
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
  <script>
    // Fade-in animation
    $(document).ready(function() {
      // Initial animation for elements in viewport
      animateElements();
      
      // Scroll animation
      $(window).scroll(function() {
        animateElements();
      });
      
      function animateElements() {
        $('.fade-in').each(function() {
          var position = $(this).offset().top;
          var scroll = $(window).scrollTop();
          var windowHeight = $(window).height();
          
          if (scroll > position - windowHeight + 100) {
            $(this).addClass('appear');
          }
        });
      }
      
      // Category pill active state
      $('.category-pill').click(function() {
        $('.category-pill').removeClass('active');
        $(this).addClass('active');
      });
    });
  </script>
</body>
</html>