<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("./partials/head") %>
    <title><%= blog.title %> | Blogifyer</title>
    <style>
        :root {
            --primary: #2c3e50;
            --secondary: #3498db;
            --accent: #e74c3c;
            --light: #ecf0f1;
            --dark: #2c3e50;
            --text: #333;
            --text-light: #666;
            --shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            --transition: all 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #f8f9fa;
            color: var(--text);
            line-height: 1.6;
        }
        
        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 0 20px;
        }
        
        /* Article Header */
        .article-header {
            margin: 3rem auto 2rem;
            text-align: center;
        }
        
        .article-category {
            display: inline-block;
            background-color: var(--accent);
            color: white;
            padding: 0.3rem 1rem;
            border-radius: 50px;
            font-size: 0.85rem;
            font-weight: 500;
            margin-bottom: 1.5rem;
            transition: var(--transition);
        }
        
        .article-category:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(231, 76, 60, 0.2);
        }
        
        .article-title {
            font-family: 'Playfair Display', serif;
            font-size: 2.8rem;
            font-weight: 700;
            line-height: 1.2;
            color: var(--dark);
            margin-bottom: 1.5rem;
        }
        
        .article-meta {
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 2rem;
            gap: 2rem;
            color: var(--text-light);
            font-size: 0.9rem;
        }
        
        .meta-item {
            display: flex;
            align-items: center;
        }
        
        .meta-item i {
            margin-right: 0.5rem;
            color: var(--secondary);
        }
        
        /* Featured Image */
        .featured-image-container {
            position: relative;
            margin: 0 -20px 3rem;
            height: 500px;
            overflow: hidden;
            border-radius: 12px;
            box-shadow: var(--shadow);
        }
        
        .featured-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }
        
        .featured-image-container:hover .featured-image {
            transform: scale(1.03);
        }
        
        /* Article Content */
        .article-content {
            background-color: white;
            padding: 3rem;
            border-radius: 12px;
            box-shadow: var(--shadow);
            margin-bottom: 3rem;
            position: relative;
        }
        
        .article-content::before {
            content: '"';
            position: absolute;
            top: 10px;
            left: 20px;
            font-size: 8rem;
            font-family: 'Playfair Display', serif;
            color: rgba(0, 0, 0, 0.05);
            line-height: 1;
        }
        
        .article-body {
            font-size: 1.1rem;
            line-height: 1.8;
            color: var(--text);
            white-space: pre-wrap;
            margin-bottom: 2rem;
        }
        
        .article-body p {
            margin-bottom: 1.5rem;
        }
        
        /* Author Section */
        .author-section {
            display: flex;
            align-items: center;
            margin: 3rem 0;
            padding: 1.5rem;
            background-color: white;
            border-radius: 12px;
            box-shadow: var(--shadow);
            border-left: 4px solid var(--secondary);
        }
        
        .author-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            object-fit: cover;
            margin-right: 1.5rem;
            border: 3px solid var(--light);
        }
        
        .author-info {
            flex: 1;
        }
        
        .author-name {
            font-family: 'Playfair Display', serif;
            font-size: 1.4rem;
            margin-bottom: 0.5rem;
            color: var(--dark);
        }
        
        .author-bio {
            color: var(--text-light);
            font-size: 0.95rem;
            line-height: 1.6;
        }
        
        .author-social {
            display: flex;
            gap: 0.8rem;
            margin-top: 1rem;
        }
        
        .social-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background-color: #f0f2f5;
            color: var(--text);
            text-decoration: none;
            transition: var(--transition);
        }
        
        .social-icon:hover {
            background-color: var(--secondary);
            color: white;
            transform: translateY(-3px);
        }
        
        /* Tags */
        .article-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-bottom: 3rem;
        }
        
        .tag {
            background-color: #f0f2f5;
            color: var(--text-light);
            padding: 0.3rem 1rem;
            border-radius: 50px;
            font-size: 0.8rem;
            transition: var(--transition);
        }
        
        .tag:hover {
            background-color: var(--secondary);
            color: white;
        }
        
        /* Share Section */
        .share-section {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 2rem 0;
            margin-bottom: 3rem;
            border-top: 1px solid #eee;
            border-bottom: 1px solid #eee;
        }
        
        .share-label {
            font-weight: 600;
            margin-right: 1rem;
        }
        
        .share-buttons {
            display: flex;
            gap: 0.8rem;
        }
        
        .share-button {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            color: white;
            text-decoration: none;
            transition: var(--transition);
        }
        
        .share-button:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }
        
        .share-twitter { background-color: #1DA1F2; }
        .share-facebook { background-color: #4267B2; }
        .share-linkedin { background-color: #0077B5; }
        .share-pinterest { background-color: #E60023; }
        
        /* Comments Section */
        .comments-section {
            background-color: white;
            padding: 2rem;
            border-radius: 12px;
            box-shadow: var(--shadow);
            margin-bottom: 3rem;
        }
        
        .comments-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid #eee;
        }
        
        .comments-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            color: var(--dark);
        }
        
        .comments-count {
            background-color: var(--secondary);
            color: white;
            padding: 0.2rem 0.8rem;
            border-radius: 50px;
            font-size: 0.9rem;
        }
        
        .comment {
            padding: 1.5rem 0;
            border-bottom: 1px solid #f1f1f1;
        }
        
        .comment:last-child {
            border-bottom: none;
        }
        
        .comment-content {
            font-size: 1rem;
            line-height: 1.6;
            margin-bottom: 1rem;
        }
        
        .comment-meta {
            display: flex;
            align-items: center;
        }
        
        .commenter-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            margin-right: 1rem;
        }
        
        .commenter-name {
            font-weight: 600;
            color: var(--dark);
            margin-right: 0.5rem;
        }
        
        .comment-date {
            color: var(--text-light);
            font-size: 0.85rem;
        }
        
        /* Comment Form */
        .comment-form {
            background-color: white;
            padding: 2rem;
            border-radius: 12px;
            box-shadow: var(--shadow);
            margin-bottom: 3rem;
        }
        
        .comment-form-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            margin-bottom: 1.5rem;
            color: var(--dark);
        }
        
        .comment-form-container {
            position: relative;
        }
        
        .comment-input {
            width: 100%;
            padding: 1rem;
            border: 1px solid #eee;
            border-radius: 8px;
            font-size: 1rem;
            transition: var(--transition);
            resize: vertical;
            min-height: 100px;
        }
        
        .comment-input:focus {
            outline: none;
            border-color: var(--secondary);
            box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
        }
        
        .comment-submit {
            display: inline-block;
            margin-top: 1rem;
            padding: 0.8rem 2rem;
            background-color: var(--secondary);
            color: white;
            border: none;
            border-radius: 50px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
        }
        
        .comment-submit:hover {
            background-color: var(--primary);
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }
        
        /* Related Articles */
        .related-articles {
            margin-top: 3rem;
            margin-bottom: 3rem;
        }
        
        .related-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.8rem;
            margin-bottom: 1.5rem;
            color: var(--dark);
            text-align: center;
        }
        
        .related-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.5rem;
        }
        
        .related-card {
            background-color: white;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: var(--shadow);
            transition: var(--transition);
        }
        
        .related-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
        }
        
        .related-img-container {
            height: 180px;
            overflow: hidden;
        }
        
        .related-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }
        
        .related-card:hover .related-img {
            transform: scale(1.1);
        }
        
        .related-content {
            padding: 1.2rem;
        }
        
        .related-category {
            color: var(--secondary);
            font-size: 0.8rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            display: block;
        }
        
        .related-card-title {
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            line-height: 1.4;
            color: var(--dark);
        }
        
        .related-link {
            display: inline-flex;
            align-items: center;
            color: var(--accent);
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 600;
            transition: var(--transition);
        }
        
        .related-link i {
            margin-left: 0.3rem;
            transition: transform 0.2s ease;
        }
        
        .related-link:hover {
            color: var(--primary);
        }
        
        .related-link:hover i {
            transform: translateX(3px);
        }
        
        /* Back to top */
        .back-to-top {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 50px;
            height: 50px;
            background-color: var(--secondary);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            font-size: 1.2rem;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
            z-index: 1000;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }
        
        .back-to-top.visible {
            opacity: 1;
            visibility: visible;
        }
        
        .back-to-top:hover {
            background-color: var(--primary);
            transform: translateY(-5px);
        }
        
        /* Responsive */
        @media (max-width: 992px) {
            .article-title {
                font-size: 2.3rem;
            }
            
            .featured-image-container {
                height: 400px;
            }
            
            .article-content {
                padding: 2rem;
            }
            
            .related-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
        
        @media (max-width: 768px) {
            .article-title {
                font-size: 2rem;
            }
            
            .article-meta {
                flex-direction: column;
                gap: 0.5rem;
            }
            
            .featured-image-container {
                height: 300px;
            }
            
            .author-section {
                flex-direction: column;
                text-align: center;
            }
            
            .author-avatar {
                margin-right: 0;
                margin-bottom: 1rem;
            }
            
            .author-social {
                justify-content: center;
            }
            
            .related-grid {
                grid-template-columns: 1fr;
            }
        }
        
        @media (max-width: 576px) {
            .article-title {
                font-size: 1.8rem;
            }
            
            .featured-image-container {
                height: 250px;
            }
            
            .article-content {
                padding: 1.5rem;
            }
            
            .share-section {
                flex-direction: column;
                gap: 1rem;
            }
        }
        
        /* Animation */
        .fade-in {
            opacity: 0;
            transform: translateY(20px);
            transition: opacity 0.5s ease, transform 0.5s ease;
        }
        
        .fade-in.appear {
            opacity: 1;
            transform: translateY(0);
        }
    </style>
</head>
<body>
    <%- include("./partials/nav") %>

    <main class="container">
        <article>
            <!-- Article Header -->
            <header class="article-header fade-in">
                <a href="/category/<%= blog.category || 'general' %>" class="article-category"><%= blog.category || 'General' %></a>
                <h1 class="article-title"><%= blog.title %></h1>
                <div class="article-meta">
                    <span class="meta-item">
                        <i class="fas fa-user"></i> <%= blog.createdBy.fullName %>
                    </span>
                    <span class="meta-item">
                        <i class="fas fa-calendar"></i> <%= new Date(blog.createdAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %>
                    </span>
                    <span class="meta-item">
                        <i class="fas fa-clock"></i> <%= Math.ceil(blog.body.split(' ').length / 200) %> min read
                    </span>
                    <span class="meta-item">
                        <i class="fas fa-comment"></i> <%= comments.length %> comments
                    </span>
                </div>
            </header>
            
            <!-- Featured Image -->
            <div class="featured-image-container fade-in">
                <img class="featured-image" src="<%= blog.coverImageUrl %>" alt="<%= blog.title %>">
            </div>
            
            <!-- Article Content -->
            <div class="article-content fade-in">
                <div class="article-body">
                    <%= blog.body %>
                </div>
                
                <!-- Tags -->
                <div class="article-tags">
                    <% ['Design', 'Technology', 'Creativity', 'Tutorial'].forEach(tag => { %>
                        <span class="tag">#<%= tag %></span>
                    <% }) %>
                </div>
                
                <!-- Share Section -->
                <div class="share-section">
                    <span class="share-label">Share this article:</span>
                    <div class="share-buttons">
                        <a href="#" class="share-button share-twitter" aria-label="Share on Twitter">
                            <i class="fab fa-twitter"></i>
                        </a>
                        <a href="#" class="share-button share-facebook" aria-label="Share on Facebook">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                        <a href="#" class="share-button share-linkedin" aria-label="Share on LinkedIn">
                            <i class="fab fa-linkedin-in"></i>
                        </a>
                        <a href="#" class="share-button share-pinterest" aria-label="Share on Pinterest">
                            <i class="fab fa-pinterest-p"></i>
                        </a>
                    </div>
                </div>
            </div>
            
            <!-- Author Section -->
            <section class="author-section fade-in">
                <img src="<%= blog.createdBy.profileImageUrl %>" class="author-avatar" alt="<%= blog.createdBy.fullName %>">
                <div class="author-info">
                    <h3 class="author-name"><%= blog.createdBy.fullName %></h3>
                    <p class="author-bio">Writer and content creator passionate about technology, design, and creativity. Follow me for more articles on the latest trends and tutorials.</p>
                    <div class="author-social">
                        <a href="#" class="social-icon" aria-label="Twitter">
                            <i class="fab fa-twitter"></i>
                        </a>
                        <a href="#" class="social-icon" aria-label="LinkedIn">
                            <i class="fab fa-linkedin-in"></i>
                        </a>
                        <a href="#" class="social-icon" aria-label="Instagram">
                            <i class="fab fa-instagram"></i>
                        </a>
                        <a href="#" class="social-icon" aria-label="Website">
                            <i class="fas fa-globe"></i>
                        </a>
                    </div>
                </div>
            </section>
        </article>
        
        <!-- Comments Section -->
        <section class="comments-section fade-in">
            <div class="comments-header">
                <h3 class="comments-title">Discussion</h3>
                <span class="comments-count"><%= comments.length %></span>
            </div>
            
            <% if (comments.length === 0) { %>
                <p class="no-comments">Be the first to start the discussion!</p>
            <% } %>
            
            <% comments.forEach(com => { %>
                <div class="comment">
                    <p class="comment-content"><%= com.content %></p>
                    <div class="comment-meta">
                        <img src="<%= com.createdBy.profileImageUrl %>" class="commenter-avatar" alt="<%= com.createdBy.fullName %>">
                        <span class="commenter-name"><%= com.createdBy.fullName %></span>
                        <span class="comment-date"><%= new Date(com.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                    </div>
                </div>
            <% }) %>
        </section>
        
        <!-- Comment Form -->
        <% if (locals.user) { %>
            <section class="comment-form fade-in">
                <h3 class="comment-form-title">Leave a Comment</h3>
                <form action="/blog/comment/<%= blog._id %>" method="POST">
                    <div class="comment-form-container">
                        <textarea class="comment-input" id="content" name="content" placeholder="Share your thoughts..." required></textarea>
                    </div>
                    <button type="submit" class="comment-submit">Post Comment</button>
                </form>
            </section>
        <% } else { %>
            <div class="comment-form fade-in">
                <h3 class="comment-form-title">Join the Discussion</h3>
                <p>Please <a href="/user/signin" style="color: var(--secondary); text-decoration: none; font-weight: 600;">sign in</a> to leave a comment.</p>
            </div>
        <% } %>
        
        <!-- Related Articles -->
        <section class="related-articles fade-in">
            <h2 class="related-title">You Might Also Like</h2>
            <div class="related-grid">
                <% for (let i = 0; i < 3; i++) { %>
                    <div class="related-card">
                        <div class="related-img-container">
                            <img src="/img/placeholder/<%= i+1 %>.jpg" alt="Related Article" class="related-img">
                        </div>
                        <div class="related-content">
                            <span class="related-category">
                                <%= ['Technology', 'Design', 'Business'][i % 3] %>
                            </span>
                            <h3 class="related-card-title">
                                <%= ['10 Tips for Better Web Design', 'The Future of AI Technology', 'How to Improve Your Coding Skills'][i % 3] %>
                            </h3>
                            <a href="#" class="related-link">
                                Read Article <i class="fas fa-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                <% } %>
            </div>
        </section>
    </main>
    
    <!-- Back to Top Button -->
    <a href="#" class="back-to-top" id="back-to-top" aria-label="Back to top">
        <i class="fas fa-chevron-up"></i>
    </a>

    <%- include("./partials/footer") %>
    <%- include("./partials/scripts") %>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Fade-in animation
            function animateElements() {
                const fadeElements = document.querySelectorAll('.fade-in');
                
                fadeElements.forEach(element => {
                    const elementPosition = element.getBoundingClientRect().top;
                    const windowHeight = window.innerHeight;
                    
                    if (elementPosition < windowHeight - 100) {
                        element.classList.add('appear');
                    }
                });
            }
            
            // Initial check
            animateElements();
            
            // On scroll
            window.addEventListener('scroll', animateElements);
            
            // Back to top button
            const backToTopButton = document.getElementById('back-to-top');
            
            window.addEventListener('scroll', function() {
                if (window.pageYOffset > 300) {
                    backToTopButton.classList.add('visible');
                } else {
                    backToTopButton.classList.remove('visible');
                }
            });
            
            backToTopButton.addEventListener('click', function(e) {
                e.preventDefault();
                window.scrollTo({
                    top: 0,
                    behavior: 'smooth'
                });
            });
        });
    </script>
</body>
</html>